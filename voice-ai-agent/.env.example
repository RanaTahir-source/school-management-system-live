# Copy this file to .env and fill in real values before running locally.
# On Railway (production), set these as service environment variables instead.

# --- LiveKit Cloud (same project as school-management-system/backend) -----
LIVEKIT_URL="wss://dar-e-arqam-school-95fo1l2k.livekit.cloud"
LIVEKIT_API_KEY="change-me"
LIVEKIT_API_SECRET="change-me"

# Dispatch names this worker registers under. Must match the same-named vars
# on the ERP backend (school-management-system/backend) exactly, or the
# ERP's dispatch calls will never reach this worker.
LIVEKIT_AI_AGENT_NAME="school-ai-receptionist"
LIVEKIT_NOTETAKER_AGENT_NAME="school-ai-notetaker"

# --- Voice pipeline providers ------------------------------------------------
DEEPGRAM_API_KEY="change-me"
ANTHROPIC_API_KEY="change-me"

# --- voice-agent-service (same backend the phone/Vapi assistant uses) -------
VOICE_AGENT_SERVICE_URL="http://localhost:3001"
VOICE_AGENT_SERVICE_API_KEY="change-me-matching-voice-agent-service/.env"

# --- Main ERP (school-management-system/backend) ----------------------------
# Used only for posting AI chat messages and ending the call - shares the same
# secret voice-agent-service already uses to call the ERP's /voice-integration
# routes (VOICE_AGENT_INTEGRATION_KEY in backend/.env).
ERP_BASE_URL="http://localhost:3000"
ERP_INTEGRATION_KEY="change-me-matching-backend/.env-VOICE_AGENT_INTEGRATION_KEY"
